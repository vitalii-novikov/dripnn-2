# Значения локального стека печатает `supabase status -o env`.
# Скрипты тестов читают их оттуда напрямую; этот файл нужен для `next dev`
# и для продакшена на Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только для *.server.ts и серверных скриптов. В клиентский бандл не попадает.
SUPABASE_SERVICE_ROLE_KEY=
