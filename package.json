{
  "name": "dripnn-2",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:integration": "node scripts/with-supabase-env.mjs start-server-and-test dev http://127.0.0.1:3000 \"vitest run --config vitest.integration.config.mts\"",
    "test:e2e": "node scripts/with-supabase-env.mjs playwright test",
    "e2e:install": "playwright install chromium webkit",
    "verify:types": "node scripts/verify-generated-types.mjs",
    "db:reset": "supabase db reset",
    "build": "next build",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run db:reset && npm run test:db && npm run verify:types && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "start-server-and-test": "^3.0.12",
    "supabase": "^2.117.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
